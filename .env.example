# ==========================================
# Application
# ==========================================
APP_NAME=nyc-taxi-lakehouse
APP_ENV=development
APP_TIMEZONE=America/Santo_Domingo
# DEBUG | INFO | WARNING | ERROR | CRITICAL
APP_LOG_LEVEL=INFO

# =====================
# Logging
# =====================
LOG_DIRECTORY=logs
LOG_MAX_SIZE_MB=20
LOG_BACKUP_COUNT=5

# =====================
# HTTP
# =====================
HTTP_TIMEOUT=30
HTTP_MAX_RETRIES=3
HTTP_USER_AGENT=nyc-taxi-lakehouse/1.0

# =====================
# MinIO
# =====================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=

MINIO_RAW_BUCKET=raw
MINIO_LOG_BUCKET=logs
